# ==============================================================================
# Converzia — Environment Configuration Template (.env)
# ==============================================================================

# --- Application Settings ---
PROJECT_NAME="Converzia — AI B2B Sales Outreach Platform"
ENVIRONMENT="development"
DEBUG=True

# --- Database Configuration (PostgreSQL) ---
# If left commented or unreachable, Converzia automatically falls back to SQLite (converzia.db)
# for zero-friction local testing and candidate code reviews.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=converzia_db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/converzia_db

# --- OpenAI & LangChain Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# --- Email Dispatcher (Brevo / Sendinblue / Mock) ---
# Set USE_MOCK_DISPATCHER=True to run high-volume simulations without sending real emails
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=outreach@converzia.ai
SENDER_NAME="Converzia Sales Team"
USE_MOCK_DISPATCHER=True

# --- CRM Synchronization (HubSpot) ---
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here
HUBSPOT_ENABLED=False

# --- Telemetry & Tracking URL ---
BASE_TRACKING_URL=http://localhost:8000/api/v1/tracking

# --- High-Volume Batch Worker Settings ---
MAX_DAILY_LEAD_CAPACITY=1000
MAX_CONCURRENT_SCRAPES=10
SCRAPER_TIMEOUT_SECONDS=12
